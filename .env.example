SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional
# DATABASE_URL=sqlite:///data/benoss.sqlite
# REMEMBER_DAYS=30
# MAX_CONTENT_LENGTH=1073741824
# SESSION_COOKIE_SECURE=0
# SESSION_COOKIE_SAMESITE=Lax
# BOARD_DEFAULT_DAYS=7

ALIYUN_OSS_ENDPOINT=oss-cn-region.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=your-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-key-secret
ALIYUN_OSS_BUCKET=your-bucket
ALIYUN_OSS_PREFIX=benoss
ALIYUN_OSS_PUBLIC_BASE_URL=https://your-public-domain
ALIYUN_OSS_ASSUME_PUBLIC=0

# AI provider: chatanywhere / deepseek / aliyun
AI_AUTOFILL_PROVIDER=
# AI_REQUEST_TIMEOUT_SECONDS=45
# AI_MAX_NOTICE_RECORDS=180
# AI_IMAGE_MODEL=gpt-image-1
# NOTEBOOKLM_STORAGE_PATH=~/.notebooklm/storage_state.json
# NOTEBOOKLM_AUDIO_LANGUAGE=zh-CN
# NOTEBOOKLM_AUDIO_TIMEOUT_SECONDS=900
# NOTEBOOKLM_SOURCE_WAIT_TIMEOUT_SECONDS=240
# NOTEBOOKLM_AUTO_DELETE_NOTEBOOK=1
# NOTEBOOKLM_AUDIO_INSTRUCTIONS=
# DIGEST_TIMEZONE=Asia/Shanghai

CHAT_ANYWHERE_API_KEY=
CHAT_ANYWHERE_API_BASE_URL=https://api.chatanywhere.tech/v1
CHAT_ANYWHERE_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

ALIYUN_AI_API_KEY=
ALIYUN_AI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_AI_MODEL=qwen-plus
